# - {{official_email}}: fest@iam.ac.in
# - {{official_phone}}: +91 98301 44521
# ==============================================================================
VITE_EMAILJS_SERVICE_ID="service_b9a7jvb"
VITE_EMAILJS_TEMPLATE_ID="template_zkrj4e8"
